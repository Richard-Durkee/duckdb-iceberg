# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/reads/scan_order_tied_files.test
# group: [reads]

include test/sql/init_requires

require-env CATALOG_TEST_CONFIG_SETUP

statement ok
DROP TABLE IF EXISTS my_datalake.default.scan_order_tied_files;

statement ok
CREATE TABLE my_datalake.default.scan_order_tied_files (a BIGINT, b BIGINT);

# Two files whose bounds on a both tie at 1. The second key decides which row comes first.
statement ok
INSERT INTO my_datalake.default.scan_order_tied_files VALUES (1, 2);

statement ok
INSERT INTO my_datalake.default.scan_order_tied_files VALUES (1, 1);

query II
SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a ASC, b ASC LIMIT 1;
----
1	1

query II
SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a ASC, b DESC LIMIT 1;
----
1	2

query II
SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a DESC, b ASC LIMIT 1;
----
1	1

query II
SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a DESC, b DESC LIMIT 1;
----
1	2

# A tied file can hold a top-N row, so both files are read
query II
EXPLAIN ANALYZE SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a ASC, b ASC LIMIT 1;
----
analyzed_plan	<REGEX>:.*Total Files Read: 2\s+.*

statement ok
DROP TABLE my_datalake.default.scan_order_tied_files;

# Files that overlap only at a shared bound value: [1, 3] and [3, 5]
statement ok
CREATE TABLE my_datalake.default.scan_order_tied_files (a BIGINT, b BIGINT);

statement ok
INSERT INTO my_datalake.default.scan_order_tied_files VALUES (1, 10), (3, 20);

statement ok
INSERT INTO my_datalake.default.scan_order_tied_files VALUES (3, 5), (5, 1);

query II
SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a ASC, b ASC LIMIT 2;
----
1	10
3	5

query II
SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a DESC, b DESC LIMIT 2;
----
5	1
3	20

# Files whose bounds do not touch are still pruned
statement ok
INSERT INTO my_datalake.default.scan_order_tied_files VALUES (7, 1), (9, 1);

query II
EXPLAIN ANALYZE SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a ASC, b ASC LIMIT 1;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

query II
EXPLAIN ANALYZE SELECT a, b FROM my_datalake.default.scan_order_tied_files ORDER BY a DESC, b ASC LIMIT 1;
----
analyzed_plan	<REGEX>:.*Total Files Read: 1\s+.*

statement ok
DROP TABLE my_datalake.default.scan_order_tied_files;
